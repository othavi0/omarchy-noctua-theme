// Opt-in token refinements for the Noctua theme.
//
// Why this is a snippet:
// Omarchy generates the VS Code theme from colors.toml and cannot push token
// customizations. Paste the block below into ~/.config/Code/User/settings.json
// (merge with existing keys). The "[One Dark Pro]" scope keeps these
// refinements from leaking into other themes, so they only apply when you
// select the One Dark Pro extension theme yourself.
{
  "editor.tokenColorCustomizations": {
    "[One Dark Pro]": {
      "comments": {
        "foreground": "#727a86",
        "fontStyle": "italic"
      },
      "textMateRules": [
        {
          "scope": ["keyword", "keyword.control", "storage", "storage.type"],
          "settings": { "fontStyle": "italic" }
        },
        {
          "scope": [
            "entity.name.function",
            "support.function",
            "meta.function-call entity.name.function"
          ],
          "settings": { "fontStyle": "bold" }
        },
        {
          "scope": [
            "entity.name.type",
            "entity.name.class",
            "support.type",
            "support.class"
          ],
          "settings": { "fontStyle": "bold" }
        },
        {
          "scope": ["entity.name.tag"],
          "settings": { "fontStyle": "bold" }
        }
      ]
    }
  }
}
